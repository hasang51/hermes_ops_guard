[Unit]
Description=OpsGuard production server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/opsguard
Environment=NODE_ENV=production
Environment=HERMES_TRANSPORT=local
Environment=OPSGUARD_TELEGRAM_TARGET=telegram
Environment="PATH=/home/hermes/.hermes/node/bin:/home/hermes/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/hermes/.hermes/node/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
